import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class SanoMovilGUI extends JFrame {

    // Paleta de colores basada en la app
    private final Color COLOR_FONDO = new Color(24, 48, 48);      // Verde muy oscuro
    private final Color COLOR_BOTON = new Color(74, 150, 138);    // Verde azulado
    private final Color COLOR_TEXTO = Color.WHITE;

    public SanoMovilGUI() {
        // Configuración básica de la ventana (simulando pantalla de teléfono)
        setTitle("Sano Móvil");
        setSize(360, 640);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null); // Centrar en pantalla
        setLayout(new BorderLayout());

        // 1. PANEL SUPERIOR (Encabezado y Menú)
        JPanel topPanel = new JPanel();
        topPanel.setLayout(new BoxLayout(topPanel, BoxLayout.Y_AXIS));
        topPanel.setBackground(COLOR_FONDO);
        topPanel.setBorder(BorderFactory.createEmptyBorder(15, 15, 10, 15));

        JLabel titleLabel = new JLabel("Sano Móvil");
        titleLabel.setFont(new Font("SansSerif", Font.BOLD, 22));
        titleLabel.setForeground(COLOR_TEXTO);

        // Barra de pestañas simples (Principal, Ayuda, Configuración)
        JPanel navPanel = new JPanel(new FlowLayout(FlowLayout.LEFT, 15, 10));
        navPanel.setBackground(COLOR_FONDO);

        JLabel tabPrincipal = new JLabel("Principal");
        tabPrincipal.setFont(new Font("SansSerif", Font.BOLD, 14));
        tabPrincipal.setForeground(COLOR_TEXTO);

        JLabel tabAyuda = new JLabel("Ayuda");
        tabAyuda.setFont(new Font("SansSerif", Font.PLAIN, 14));
        tabAyuda.setForeground(Color.LIGHT_GRAY);

        JLabel tabConfig = new JLabel("Configuración");
        tabConfig.setFont(new Font("SansSerif", Font.PLAIN, 14));
        tabConfig.setForeground(Color.LIGHT_GRAY);

        navPanel.add(tabPrincipal);
        navPanel.add(tabAyuda);
        navPanel.add(tabConfig);

        topPanel.add(titleLabel);
        topPanel.add(navPanel);

        // 2. PANEL CENTRAL (Contenido y Botones)
        JPanel mainPanel = new JPanel();
        mainPanel.setLayout(new GridLayout(5, 1, 0, 12));
        mainPanel.setBackground(COLOR_FONDO);
        mainPanel.setBorder(BorderFactory.createEmptyBorder(10, 20, 20, 20));

        // Subtítulo
        JLabel subTitle = new JLabel("Su Salud en Movimiento", SwingConstants.CENTER);
        subTitle.setFont(new Font("SansSerif", Font.BOLD, 18));
        subTitle.setForeground(COLOR_TEXTO);

        JLabel descText = new JLabel("Tome el control de su bienestar hoy.", SwingConstants.CENTER);
        descText.setFont(new Font("SansSerif", Font.PLAIN, 12));
        descText.setForeground(Color.LIGHT_GRAY);

        JPanel headerTextPanel = new JPanel(new GridLayout(2, 1));
        headerTextPanel.setBackground(COLOR_FONDO);
        headerTextPanel.add(subTitle);
        headerTextPanel.add(descText);

        // Botones de la interfaz
        JButton btnRevision = crearBoton("Revisión del dispositivo");
        JButton btnArchivos = crearBoton("Archivos");
        JButton btnOtros = crearBoton("Otros");

        // 3. EVENTOS DE CLIC (Interactividad)
        btnRevision.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                JOptionPane.showMessageDialog(null, "Abriendo: Revisión del dispositivo...");
            }
        });

        btnArchivos.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                JOptionPane.showMessageDialog(null, "Abriendo: Archivos...");
            }
        });

        btnOtros.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                JOptionPane.showMessageDialog(null, "Abriendo: Otros...");
            }
        });

        // Agregar elementos al panel principal
        mainPanel.add(headerTextPanel);
        mainPanel.add(btnRevision);
        mainPanel.add(btnArchivos);
        mainPanel.add(btnOtros);

        // Agregar paneles a la ventana
        add(topPanel, BorderLayout.NORTH);
        add(mainPanel, BorderLayout.CENTER);
    }

    // Método auxiliar para estilizar los botones
    private JButton crearBoton(String texto) {
        JButton btn = new JButton(texto);
        btn.setFont(new Font("SansSerif", Font.BOLD, 16));
        btn.setBackground(COLOR_BOTON);
        btn.setForeground(COLOR_TEXTO);
        btn.setFocusPainted(false);
        btn.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));
        return btn;
    }

    public static void main(String[] args) {
        // Ejecutar la interfaz en el hilo de eventos de Swing
        SwingUtilities.invokeLater(() -> {
            new SanoMovilGUI().setVisible(true);
        });
    }
}
