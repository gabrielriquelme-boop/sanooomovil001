package proyecto2;
import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionListener;

public class PantallaEscaneo extends JPanel {

    private final Color COLOR_FONDO = new Color(24, 48, 48);
    private final Color COLOR_BOTON = new Color(74, 150, 138);
    private final Color COLOR_TEXTO = Color.WHITE;

    private JLabel lblTiempo;
    private CirculoCargando circuloCargando;

    public PantallaEscaneo(ActionListener accionCancelar) {
        setLayout(new BorderLayout());
        setBackground(COLOR_FONDO);
        setBorder(BorderFactory.createEmptyBorder(25, 20, 20, 20));

        JLabel lblTitulo = new JLabel("Analizando dispositivo...", SwingConstants.CENTER);
        lblTitulo.setFont(new Font("SansSerif", Font.BOLD, 20));
        lblTitulo.setForeground(COLOR_TEXTO);

        JLabel lblSub = new JLabel("Esto puede demorar unos minutos", SwingConstants.CENTER);
        lblSub.setFont(new Font("SansSerif", Font.PLAIN, 13));
        lblSub.setForeground(Color.LIGHT_GRAY);

        JPanel headerPanel = new JPanel(new GridLayout(2, 1, 0, 8));
        headerPanel.setBackground(COLOR_FONDO);
        headerPanel.add(lblTitulo);
        headerPanel.add(lblSub);

        circuloCargando = new CirculoCargando(COLOR_BOTON, COLOR_FONDO);

        lblTiempo = new JLabel("Tiempo estimado: 02:00", SwingConstants.CENTER);
        lblTiempo.setFont(new Font("SansSerif", Font.BOLD, 16));
        lblTiempo.setForeground(COLOR_TEXTO);

        // Botón Cancelar / Salir accesible en todo momento
        JButton btnCancelar = new JButton("Cancelar / Salir del Escaneo");
        btnCancelar.setFont(new Font("SansSerif", Font.BOLD, 14));
        btnCancelar.setBackground(new Color(180, 70, 70)); // Rojo suave
        btnCancelar.setForeground(COLOR_TEXTO);
        btnCancelar.setFocusPainted(false);
        btnCancelar.addActionListener(accionCancelar);

        JPanel bottomPanel = new JPanel(new GridLayout(2, 1, 0, 10));
        bottomPanel.setBackground(COLOR_FONDO);
        bottomPanel.add(lblTiempo);
        bottomPanel.add(btnCancelar);

        add(headerPanel, BorderLayout.NORTH);
        add(circuloCargando, BorderLayout.CENTER);
        add(bottomPanel, BorderLayout.SOUTH);
    }

    public void actualizarTiempo(int segundosTotales) {
        int minutos = segundosTotales / 60;
        int segundos = segundosTotales % 60;
        lblTiempo.setText(String.format("Tiempo estimado: %02d:%02d", minutos, segundos));
    }

    public void iniciarAnimacion() { circuloCargando.iniciarAnimacion(); }
    public void detenerAnimacion() { circuloCargando.detenerAnimacion(); }

    private class CirculoCargando extends JPanel {
        private int anguloInicio = 0;
        private Timer timerAnimacion;
        private Color colorCirculo;

        public CirculoCargando(Color colorCirculo, Color colorFondo) {
            this.colorCirculo = colorCirculo;
            setBackground(colorFondo);
            timerAnimacion = new Timer(16, e -> {
                anguloInicio = (anguloInicio + 5) % 360;
                repaint();
            });
        }

        public void iniciarAnimacion() { timerAnimacion.start(); }
        public void detenerAnimacion() { timerAnimacion.stop(); }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2d = (Graphics2D) g;
            g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int diametro = Math.min(getWidth(), getHeight()) - 60;
            int x = (getWidth() - diametro) / 2;
            int y = (getHeight() - diametro) / 2;

            g2d.setStroke(new BasicStroke(8));
            g2d.setColor(new Color(255, 255, 255, 30));
            g2d.drawOval(x, y, diametro, diametro);

            g2d.setColor(colorCirculo);
            g2d.drawArc(x, y, diametro, diametro, anguloInicio, 100);
        }
    }
}
